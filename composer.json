{
  "name": "inttegro/sdk",
  "description": "Official PHP SDK for the Inttegro API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://studio.inttegro.com",
  "support": {
    "docs": "https://php.inttegro.dev/",
    "issues": "https://github.com/inttegro/inttegro-sdk-php/issues",
    "source": "https://github.com/inttegro/inttegro-sdk-php"
  },
  "autoload": {
    "psr-4": {
      "Inttegro\\": "src/Inttegro/"
    },
    "files": [
      "src/Inttegro/ErrorReporting.php",
      "src/Inttegro/Errors.php"
    ]
  },
  "require": {
    "php": ">=8.1",
    "open-telemetry/api": "^1.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "minimum-stability": "stable"
}
