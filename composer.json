{
  "name": "inttegro/sdk",
  "description": "Official PHP SDK for the Inttegro API",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Inttegro\\": "src/Inttegro/"
    },
    "files": [
      "src/Inttegro/Errors.php",
      "src/Inttegro/Enums.php"
    ]
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "minimum-stability": "stable"
}
